# -----------------------------------------------------------------------------
# Sanity CMS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=
NEXT_PUBLIC_SANITY_STUDIO_NAME=""

# Server-side secrets (Store real keys only in .env.local / Vercel secrets)
SANITY_ACCESS_TOKEN=your_sanity_access_token_here
SANITY_HOOK_SECRET=your_sanity_hook_secret_here
SANITY_REVALIDATE_SECONDS=3600

# -----------------------------------------------------------------------------
# Security & Captcha
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

